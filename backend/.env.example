# 各模型 API Key（留空则后端以 mock 流式返回示例；也可在网页「连接设置」里输入保存）
KEY_ANT=
KEY_DEEPSEEK=
KEY_ZHIPU=
KEY_MOONSHOT=
KEY_DOUBAO=

# 后端端口（默认 8000）
PORT=8000

# 数据库路径（本地默认 backend/data/duizhao.db；线上 veFaaS 设为 /tmp，例如下面这行）
# DATABASE_URL=sqlite:////tmp/data/app.db

# 生成媒体落盘目录（本地默认 backend/data/media；线上 veFaaS 挂载 TOS 后设为挂载点下目录，如 /mnt/data/media）
# MEDIA_DIR=/mnt/data/media

# 持久化目录：把 SQLite 快照备份到 TOS 挂载点，新实例启动时自动恢复（未设置则不启用）
# PERSIST_DIR=/mnt/data

# 上游并发闸门：限制同时进行的真实模型请求数，避免大量并发触发 429/509 限流
# MAX_UPSTREAM_CONCURRENCY=4
